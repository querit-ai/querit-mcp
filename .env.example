# Local development keeps anonymous access disabled. Use a personal key in the
# MCP client's Authorization header when testing tools against the real API.
MCP_FREE_TIER_ENABLED=false
QUERIT_API_BASE=https://api.querit.ai
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# Production anonymous access requires all three secrets below.
# QUERIT_MCP_FREE_API_KEY=
# REDIS_URL=rediss://...
# MCP_FREE_IP_HMAC_SECRET=
